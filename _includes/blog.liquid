<div class="blog">
  <!-- Blog Header -->
  <div class="row mb-4">
    <div class="col-lg-8">
      <h2 class="mb-3">Blog Posts</h2>
      <p class="text-muted">A collection of posts organized by topics and time order.</p>
    </div>
    <div class="col-lg-4 text-lg-end">
      <div class="btn-group" role="group" aria-label="View options">
        <button type="button" class="btn btn-outline-primary active" id="view-all">All Posts</button>
        <button type="button" class="btn btn-outline-primary" id="view-topics">By Topic</button>
        <button type="button" class="btn btn-outline-primary" id="view-timeline">Timeline</button>
      </div>
    </div>
  </div>

  <!-- Filter Controls -->
  <div class="row mb-4" id="filter-controls">
    <div class="col-md-6">
      <select class="form-select" id="topic-filter">
        <option value="">All Topics</option>
        {% assign all_tags = site.posts | map: "tags" | compact | uniq | sort %}
        {% for tag in all_tags %}
          {% if tag != nil and tag != "" %}
            <option value="{{ tag }}">{{ tag | capitalize }}</option>
          {% endif %}
        {% endfor %}
      </select>
    </div>
    <div class="col-md-6">
      <select class="form-select" id="year-filter">
        <option value="">All Years</option>
        {% assign all_years = site.posts | map: "date" | compact | map: "year" | uniq | sort | reverse %}
        {% for year in all_years %}
          {% if year != nil and year != "" %}
            <option value="{{ year }}">{{ year }}</option>
          {% endif %}
        {% endfor %}
      </select>
    </div>
  </div>

  <!-- All Posts View -->
  <div id="all-posts-view" class="view-section">
    <div class="row">
      {% assign sorted_posts = site.posts | sort: 'date' | reverse %}
      {% for post in sorted_posts %}
        <div class="col-lg-6 col-xl-4 mb-4 post-item" 
             data-tags="{% if post.tags %}{% for tag in post.tags %}{{ tag }} {% endfor %}{% endif %}"
             data-year="{{ post.date | date: '%Y' }}">
          <div class="card h-100">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <small class="text-muted">{{ post.date | date: "%b %d, %Y" }}</small>
                <div class="post-tags">
                  {% if post.tags %}
                    {% for tag in post.tags limit: 2 %}
                      <span class="badge bg-light text-dark me-1">{{ tag }}</span>
                    {% endfor %}
                  {% endif %}
                </div>
              </div>
              <h5 class="card-title">
                <a href="{{ post.url | relative_url }}" class="text-decoration-none">{{ post.title }}</a>
              </h5>
              {% if post.description %}
                <p class="card-text text-muted">{{ post.description }}</p>
              {% endif %}
            </div>
            <div class="card-footer bg-transparent">
              <a href="{{ post.url | relative_url }}" class="btn btn-sm btn-outline-primary">Read More</a>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>

  <!-- Topics View -->
  <div id="topics-view" class="view-section" style="display: none;">
    {% assign all_tags = site.posts | map: "tags" | compact | uniq | sort %}
    {% for tag in all_tags %}
      {% if tag != nil and tag != "" %}
        <div class="topic-section mb-5">
          <h3 class="mb-3">{{ tag | capitalize }}</h3>
          <div class="row">
            {% assign tag_posts = site.posts | where_exp: "post", "post.tags contains tag" | sort: 'date' | reverse %}
            {% for post in tag_posts %}
              <div class="col-lg-6 col-xl-4 mb-4 post-item" 
                   data-tags="{% if post.tags %}{% for tag in post.tags %}{{ tag }} {% endfor %}{% endif %}"
                   data-year="{{ post.date | date: '%Y' }}">
                <div class="card h-100">
                  <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                      <small class="text-muted">{{ post.date | date: "%b %d, %Y" }}</small>
                      <div class="post-tags">
                        {% if post.tags %}
                          {% for tag in post.tags limit: 2 %}
                            <span class="badge bg-light text-dark me-1">{{ tag }}</span>
                          {% endfor %}
                        {% endif %}
                      </div>
                    </div>
                    <h5 class="card-title">
                      <a href="{{ post.url | relative_url }}" class="text-decoration-none">{{ post.title }}</a>
                    </h5>
                    {% if post.description %}
                      <p class="card-text text-muted">{{ post.description }}</p>
                    {% endif %}
                  </div>
                  <div class="card-footer bg-transparent">
                    <a href="{{ post.url | relative_url }}" class="btn btn-sm btn-outline-primary">Read More</a>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>

  <!-- Timeline View -->
  <div id="timeline-view" class="view-section" style="display: none;">
    {% assign all_years = site.posts | map: "date" | compact | map: "year" | uniq | sort | reverse %}
    {% for year in all_years %}
      {% if year != nil and year != "" %}
        <div class="timeline-section mb-5">
          <h3 class="mb-3">{{ year }}</h3>
          <div class="timeline">
            {% assign year_posts = site.posts | where_exp: "post", "post.date contains year" | sort: 'date' | reverse %}
          {% for post in year_posts %}
            <div class="timeline-item mb-4 post-item" 
                 data-tags="{% if post.tags %}{% for tag in post.tags %}{{ tag }} {% endfor %}{% endif %}"
                 data-year="{{ post.date | date: '%Y' }}">
              <div class="row">
                <div class="col-md-3">
                  <div class="timeline-date text-muted">
                    {{ post.date | date: "%B %d" }}
                  </div>
                </div>
                <div class="col-md-9">
                  <div class="card">
                    <div class="card-body">
                      <div class="d-flex justify-content-between align-items-start mb-2">
                        <h5 class="card-title mb-0">
                          <a href="{{ post.url | relative_url }}" class="text-decoration-none">{{ post.title }}</a>
                        </h5>
                        <div class="post-tags">
                          {% if post.tags %}
                            {% for tag in post.tags limit: 2 %}
                              <span class="badge bg-light text-dark me-1">{{ tag }}</span>
                            {% endfor %}
                          {% endif %}
                        </div>
                      </div>
                      {% if post.description %}
                        <p class="card-text text-muted">{{ post.description }}</p>
                      {% endif %}
                      <a href="{{ post.url | relative_url }}" class="btn btn-sm btn-outline-primary">Read More</a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
      {% endif %}
    {% endfor %}
  </div>

  <!-- No Results Message -->
  <div id="no-results" class="text-center py-5" style="display: none;">
    <h4 class="text-muted">No posts found</h4>
    <p class="text-muted">Try adjusting your filters or view all posts.</p>
    <button class="btn btn-primary" onclick="clearFilters()">View All Posts</button>
  </div>
</div>

<style>
.timeline {
  position: relative;
}

.timeline::before {
  content: '';
  position: absolute;
  left: 15%;
  top: 0;
  bottom: 0;
  width: 2px;
  background: #e9ecef;
}

.timeline-item {
  position: relative;
}

.timeline-item::before {
  content: '';
  position: absolute;
  left: 15%;
  top: 20px;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: #007bff;
  border: 3px solid #fff;
  box-shadow: 0 0 0 3px #e9ecef;
  transform: translateX(-50%);
}

.timeline-date {
  font-weight: 500;
  padding-top: 20px;
}

.post-item {
  transition: all 0.3s ease;
}

.post-item:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 8px rgba(0,0,0,0.1);
}

.btn-group .btn.active {
  background-color: #007bff;
  border-color: #007bff;
  color: white;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const viewButtons = document.querySelectorAll('#view-all, #view-topics, #view-timeline');
  const viewSections = document.querySelectorAll('.view-section');
  const topicFilter = document.getElementById('topic-filter');
  const yearFilter = document.getElementById('year-filter');
  const postItems = document.querySelectorAll('.post-item');
  const noResults = document.getElementById('no-results');

  // View switching
  viewButtons.forEach(button => {
    button.addEventListener('click', function() {
      const targetView = this.id.replace('view-', '') + '-view';
      
      // Update button states
      viewButtons.forEach(btn => btn.classList.remove('active'));
      this.classList.add('active');
      
      // Show/hide sections
      viewSections.forEach(section => {
        section.style.display = section.id === targetView ? 'block' : 'none';
      });
      
      // Clear filters when switching views
      topicFilter.value = '';
      yearFilter.value = '';
      showAllPosts();
    });
  });

  // Filtering functionality
  function filterPosts() {
    const selectedTopic = topicFilter.value;
    const selectedYear = yearFilter.value;
    let visibleCount = 0;

    postItems.forEach(item => {
      const tags = item.dataset.tags ? item.dataset.tags.split(' ').filter(tag => tag.trim() !== '') : [];
      const year = item.dataset.year;
      
      const topicMatch = !selectedTopic || tags.includes(selectedTopic);
      const yearMatch = !selectedYear || year === selectedYear;
      
      if (topicMatch && yearMatch) {
        item.style.display = 'block';
        visibleCount++;
      } else {
        item.style.display = 'none';
      }
    });

    // Show/hide no results message
    if (visibleCount === 0) {
      noResults.style.display = 'block';
    } else {
      noResults.style.display = 'none';
    }
  }

  function showAllPosts() {
    postItems.forEach(item => {
      item.style.display = 'block';
    });
    noResults.style.display = 'none';
  }

  // Event listeners for filters
  topicFilter.addEventListener('change', filterPosts);
  yearFilter.addEventListener('change', filterPosts);

  // Global function for clearing filters
  window.clearFilters = function() {
    topicFilter.value = '';
    yearFilter.value = '';
    showAllPosts();
  };
});
</script> 