---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {{ page.title }}
      {% if page.cv_pdf %}
        <a
          href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url}}"
          target="_blank"
          rel="noopener noreferrer"
          class="float-right"
          ><i class="fa-solid fa-file-pdf"></i
        ></a>
      {% endif %}
    </h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    <div class="cv">
      <div class="card mt-3 p-3">
        <div class="text-center">
          <h3>CV Download</h3>
          <p>Click the PDF icon in the top right corner to download my CV, or use the button below:</p>
          {% if page.cv_pdf %}
            <a
              href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url}}"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary btn-lg"
            >
              <i class="fa-solid fa-file-pdf"></i> Download CV (PDF)
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </article>
</div>
